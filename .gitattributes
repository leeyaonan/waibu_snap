# 默认统一 LF，避免 macOS / Windows 双机协作时产生换行符噪音
* text=auto eol=lf

# Windows 专用脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.dmg binary
*.exe binary
*.msi binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
