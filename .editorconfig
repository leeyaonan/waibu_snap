# 跨平台编辑器统一规范（macOS / Windows 双机协作）
# C++ 与 Objective-C++ 的完整格式由 .clang-format 定义。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows 专用脚本
[*.{bat,cmd,ps1}]
end_of_line = crlf
